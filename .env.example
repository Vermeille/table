# Match the gateway's UID/GID, API key, network and named volumes.
# Fresh Hermes images default to 10000. Existing customized instances may use 1000.
HERMES_UID=10000
HERMES_GID=10000
API_SERVER_KEY=replace-with-the-hermes-gateway-key
TABLE_PASSWORD=choose-a-long-password
HERMES_URL=http://hermes-agent:8642
HERMES_CONTAINER=hermes-agent
HERMES_NETWORK=hermes
HERMES_DATA_VOLUME=hermes-data
TABLE_DATA_VOLUME=table-data
TABLE_INTERNAL_URL=http://table:8080
SERVICE_FQDN_TABLE_8080=https://table.example.com
COOKIE_SECURE=true
